{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "git": {
        "deploymentEnabled": {
            "main": true,
            "dev/": false,
            "test/":  false
        }
    },
    "regions": [ "cle1" ],
    "rewrites": [
        {
            "source": "/:path*",
            "destination": "/api/:path*"
        }
    ],
    "trailingSlash": false
}