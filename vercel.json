{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "git": {
        "deploymentEnabled": {
            "main": true,
            "dev/": false,
            "test/":  false
        }
    },
    "regions": [ "cle1" ],
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/index"
        },
        {
            "source": "/about",
            "destination": "/api/about"
        },
        {
            "source": "/projects",
            "destination": "/api/projects/index"
        },
        {
            "source": "/demos",
            "destination": "/api/demos"
        },
        {
            "source": "/projects/jeopardybuilder",
            "destination": "/api/projects/jeopardybuilder"
        },
        {
            "source": "/projects/weathertracker",
            "destination": "/api/projects/weathertracker"
        },
        {
            "source": "/projects/receiptscanner",
            "destination": "/api/projects/receiptscanner"
        }
    ],
    "trailingSlash": false
}