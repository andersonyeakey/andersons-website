{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "cleanUrls": true,
    "functionFailoverRegions": [ "iad1", "yul1" ],
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "git": {
        "deploymentEnabled": {
            "main": true,
            "*": false
        }
    },
    "regions": [ "cle1" ],

    "trailingSlash": false
}